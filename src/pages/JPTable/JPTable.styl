.pg-jp-table
  display flex
  flex-direction column
  overflow hidden
  box-sizing border-box
  padding 16px 0 0
  width 100vw
  height 100vh
  .com-breadcrumb
    padding 0 32px 16px
.pg-jp-table_content
  flex auto
  overflow auto
  padding 0 32px
.pg-jp-table_title
  getFont(.85, 14, 20)
  wb()
  margin-bottom 16px
  text-align center
.pg-jp-table_desc
  getFont(.45, 14, 20)
  wb()
  margin-bottom 16px
  text-align left
.pg-jp-table_column
  fl(flex-start)
  wb()
  padding 8px 0
  background-color #fff
  &.is-header
    position sticky
    top 0
.pg-jp-table_cell
  getFont(.65, 14, 20)
  wb()
  flex none
  text-align center
  &.is-header
    color cp
.pg-jp-table_bottom
  width 100%
  height 80px
