.pg-chapter
  display flex
  flex-direction column
  overflow hidden
  box-sizing border-box
  width 100vw
  height 100vh
  user-select none
  .ant-btn + .ant-btn
    margin-left 8px
.pg-chapter--content
  display flex
  flex auto
  flex-direction column
  overflow hidden
  box-sizing border-box
  padding 24px 32px
.pg-chapter--section
  flex auto
  overflow auto
  padding-bottom 32px
  min-height 200px
.pg-chapter--item-pre
  getFont(.25, 14, 18)
  margin-bottom 4px
.pg-chapter--item
  getFont(.65, 18, 24)
  margin-bottom 8px
.pg-chapter--placeholder
  getFont(.45, 18, 24)
.pg-chapter--footer
  display flex
  flex none
  flex-direction column
  overflow hidden
.pg-chapter--button
  bottom 0
  left 0
  flex none
  box-sizing border-box
  padding 16px 0 8px
  width 100vw
  background-color #ea4436
  color #fff
  text-align center
  font-size 30px
  cursor pointer
  user-select none
  &:last-child
    padding-bottom 16px
  &.in-reading
    background-color #4284f4
  &.in-second
    background-color #34a853
