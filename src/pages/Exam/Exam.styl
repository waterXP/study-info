.pg-exam
  display flex
  flex-direction column
  overflow hidden
  box-sizing border-box
  width 100vw
  height 100vh
  user-select none
.pg-exam_title
  white-space pre-wrap
.pg-exam_content
  display flex
  flex auto
  flex-direction column
  overflow hidden
  box-sizing border-box
  padding 24px 32px 0
.pg-exam_detail
  flex auto
  padding-bottom 24px
  overflow auto
.pg-exam_item
  getFont(.65, 16, 24)
  padding-bottom 8px
  white-space pre-wrap
.pg-exam_footer
  display flex
  flex none
  flex-direction column
  overflow hidden
.pg-exam_buttons
  display flex
  flex none
  justify-content space-between
  align-items center
  box-sizing border-box
  width 100vw
.pg-exam_corner-button
  flex none
  padding 16px 0 0
  min-width 30vw
  max-width 50vw
  background-color cw
  color #fff
  text-align center
  font-size 24px
  border-radius 0 20px 0 0
  &.is-right
    border-radius 20px 0 0 0
