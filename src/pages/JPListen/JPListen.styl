.pg-jp-listen
  display flex
  flex-direction column
  overflow hidden
  width 100vw
  height 100vh
.pg-jp-listen_header
  flex none
  padding 24px 32px 0
.pg-jp-listen_content
  flex auto
  padding 0 32px 16px
  overflow auto
.pg-jp-listen_text
  getFont(.85, 16, 24)
  padding-bottom 8px
.pg-jp-listen_footer
  display flex
  flex none
  flex-direction column
  overflow hidden
.pg-jp-listen_buttons
  display flex
  flex none
  justify-content space-between
  align-items center
  box-sizing border-box
  width 100vw
.pg-jp-listen_corner-button
  flex none
  padding 16px 0 0
  min-width 30vw
  max-width 50vw
  height 80px
  border-radius 0 20px 0 0
  background-color cw
  color #fff
  text-align center
  font-size 24px
  &.is-right
    border-radius 20px 0 0 0
