.pg-jp-n2s
  display flex
  flex-direction column
  overflow hidden
  box-sizing border-box
  width 100vw
  height 100vh
  user-select none
.pg-jp-n2s_content
  display flex
  flex auto
  flex-direction column
  overflow hidden
  box-sizing border-box
  padding 24px 0 8px
.pg-jp-n2s_header
  flex none
  padding 0 32px
.pg-jp-n2s_lesson
  flex auto
  overflow auto
  padding 0 32px
.pg-jp-n2s_topic
  getFont(.85, 16, 24)
  wb()
.pg-jp-n2s_titles
  margin 8px 0
.pg-jp-n2s_title
  getFont(.85, 16, 24)
  wb()
.pg-jp-n2s_cn
  getFont(.45, 14, 24)
  padding-left 8px
.pg-jp-n2s_footer
  display flex
  flex none
  flex-direction column
  overflow hidden
.pg-jp-n2s_buttons
  display flex
  flex none
  justify-content space-between
  align-items center
  box-sizing border-box
  width 100vw
.pg-jp-n2s_corner-button
  flex none
  padding 16px 0 0
  min-width 30vw
  max-width 50vw
  height 80px
  border-radius 0 20px 0 0
  background-color cw
  color #fff
  text-align center
  font-size 24px
  &.is-right
    border-radius 20px 0 0 0
.pg-jp-n2s_examples
  font-style italic
.pg-jp-n2s_example
  getFont(.65, 14, 18)
  padding-left 8px
