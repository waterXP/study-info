.pg-cabinet-pick-list
  flf(auto, center)
  flex-direction column
.pg-cabinet-pick-list_title
  f(ft85, 32, 48)
  padding 24px 0 48px
  text-align center
.pg-cabinet-pick-list_body
  flf(none, center, space-between)
.pg-cabinet-pick-list_arrorw.iconfont
  f(ft65, 24, 32)
  flex none
  margin 0 16px
  padding 63px 12px
  border 1px solid ft65
  border-radius 4px
  &.is-disabled
    opacity .25
    cursor not-allowed
.pg-cabinet-pick-list_wrap
  flex none
  width 558px
.pg-cabinet-pick-list_button-wrap
  width 186px
.pg-cabinet-pick-list_button-static-wrap
  flex none
.pg-cabinet-pick-list_button
  flf(none, center, center)
  box-sizing border-box
  margin 0 16px
  padding 24px 0
  border 1px solid ft65
  border-radius 4px
  text-align center
  height 160px
.pg-cabinet-pick-list_button-text
  f(ft65, 24, 32)
