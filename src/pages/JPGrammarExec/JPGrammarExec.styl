.pg-jp-grammar-exec_process
  fl(center)
  margin-bottom 8px
  width calc(100vw - 64px)
.pg-jp-grammar-exec_p
  flex 1
  height 8px
  background-color #ccc
  &:first-child
    border-radius 4px 0 0 4px
  &:last-child
    border-radius 0 4px 4px 0
  &.is-correct
    background-color cs
  &.is-error
    background-color cd
  &.is-current
    outline 1px solid cp
  + .pg-jp-grammar-exec_p
    margin-left 1px
.pg-jp-grammar-exec_pre
  getFont(.85, 14, 22)
  padding 0 32px 8px
.pg-jp-grammar-exec_title
  getFont(.85, 16, 24)
  weight()
  padding 0 32px 8px
  text-align center
.pg-jp-grammar-exec_author
  getFont(.85, 14, 22)
  padding 0 32px 8px
  text-align right
.pg-jp-grammar-exec_block
  getFont(.85, 16, 24)
  padding 0 32px 8px
  white-space pre-wrap
  .is-correct
    color cs
  .is-error
    color cd
  .is-current
    color cp
  .is-star
    weight(600)
.pg-jp-grammar-exec_answer
  getFont(.65, 16, 24)
  padding 8px 32px
  &.is-correct
    color cs
  &.is-error
    color cw
  &.is-primary
    color cd
.pg-jp-grammar-exec_qus-wrap
  fl(center)
  flex-wrap wrap
  padding 0 24px
.pg-jp-grammar-exec_qus
  f(#fff, 32, 48)
  flex none
  box-sizing border-box
  margin 0 8px 8px
  width 48px
  border-radius 4px
  background-color cp
  text-align center
  &.is-current
    outline 2px solid cw
  &.is-correct
    background-color cs
  &.is-error
    background-color cd
.pg-jp-grammar-exec_line
  margin 0 auto
  width calc(100vw - 64px)
  height 1px
  background-color #ccc
.pg-jp-grammar-exec_no
  display inline-block
  min-width 16px
  text-align left
