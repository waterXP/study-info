.pg-jp-words-list
  display flex
  flex-direction column
  overflow hidden
  box-sizing border-box
  width 100vw
  height 100vh
  user-select none
.pg-jp-words-list_content
  display flex
  flex auto
  flex-direction column
  overflow hidden
  box-sizing border-box
  padding 24px 32px
.pg-jp-words-list_body
  justify-content center
  overflow auto
.pg-jp-words-list_line
  getFont(.65, 16, 32)
  flex none
  white-space normal
  word-break break-all
.pg-jp-words-list_division
  margin 4px 0
  height 1px
  background-color #f2f2f2
.pg-jp-words-list_footer
  display flex
  flex none
  flex-direction column
  overflow hidden
.pg-jp-words-list_buttons
  display flex
  flex none
  justify-content space-between
  align-items center
  box-sizing border-box
  width 100vw
.pg-jp-words-list_corner-button
  flex none
  padding 16px 0 0
  min-width 30vw
  max-width 50vw
  height 80px
  border-radius 0 20px 0 0
  background-color cw
  color #fff
  text-align center
  font-size 24px
  &.is-right
    border-radius 20px 0 0 0
