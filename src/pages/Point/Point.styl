.pg-point
  display flex
  flex-direction column
  overflow hidden
  box-sizing border-box
  width 100vw
  height 100vh
  user-select none
.pg-point--content
  display flex
  flex auto
  flex-direction column
  overflow hidden
  box-sizing border-box
  padding 24px 32px 32px
.pg-point--texts
  flex auto
  overflow auto
.pg-point--text
  getFont(.65, 16, 24)
  word-break break-all
  white-space pre-wrap
  overflow auto
