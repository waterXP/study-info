.pg-deprive-4
  padding-bottom 80px
.pg-deprive-4_top
  fl(center)
  padding 8px 16px
.pg-deprive-4_bottom
  fl(center)
  padding 8px 16px
.pg-deprive-4_item
  flex 1
  margin 0 8px
  min-height 250px !important
  resize none !important
.pg-deprive-4_text
  flex 1
  overflow-x auto
  margin 0 8px
  min-height 250px !important
  white-space pre
.pg-deprive-4_divider
  flex none
  align-self stretch
  width 1px
  background-color #ccc
.pg-deprive-4_value
  padding-bottom 16px
.pg-deprive-4_button
  display inline-block
  flex none
  padding 4px 12px
  border 1px solid #ccc
  border-radius 4px
.pg-deprive-4_tap
  fl(center, flex-end)
.pg-deprive-4_r-button
  display inline-block
  flex none
  margin-right 8px
  padding 4px 12px
  border 1px solid #ccc
  border-radius 4px
