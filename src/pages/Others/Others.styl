.pg-others
  display flex
  flex-direction column
  overflow hidden
  box-sizing border-box
  width 100vw
  height 100vh
  user-select none
.pg-others_content
  display flex
  flex auto
  flex-direction column
  overflow hidden
  box-sizing border-box
  padding 24px 32px 0
.pg-others_items
  flex auto
  overflow auto
  min-height 200px
.pg-others_item
  getFont(.65, 18, 24)
  margin-bottom 8px
.pg-others_footer
  display flex
  flex none
  flex-direction column
  overflow hidden
.pg-others_buttons
  display flex
  flex none
  justify-content space-between
  align-items center
  box-sizing border-box
  width 100vw
.pg-others_corner-button
  flex none
  padding 16px 0 0
  min-width 30vw
  height 80px
  max-width 50vw
  border-radius 0 20px 0 0
  background-color cw
  color #fff
  text-align center
  font-size 24px
  &.is-right
    border-radius 20px 0 0 0
.pg-others_corner-center
  flex auto
  margin 0 2px
  padding 16px 0 0
  height 80px
  background-color cw
  color #fff
  text-align center
  font-size 24px
  border-radius 20px 20px 0 0

