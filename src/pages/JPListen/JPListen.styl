.pg-jp-listen_body
  padding 0 32px
.pg-jp-listen_topic
  getFont(.85, 16, 24)
  weight()
.pg-jp-listen_text
  getFont(.85, 16, 24)
  padding-bottom 8px
  &.is-correct
    color cs
  &.is-error
    color cd
.pg-jp-listen_bottom-texts
  border-top 1px solid #eee
.pg-jp-listen_bottom-text
  getFont(.85, 16, 24)
  weight()
  padding 8px 32px
  &.is-correct
    color cs
  &.is-error
    color cd
.pg-jp-listen_answers
  fl(center)
  padding 0 16px
.pg-jp-listen_answer
  f(#fff, 32, 64)
  flex 1
  margin 0 8px 8px
  padding 8px 0
  border-radius 4px
  background-color cp
  text-align center
  opacity .8
  &.on-click
    opacity 1
  &.is-correct
    background-color cs
  &.is-error
    background-color cd
.pg-jp-listen_a-list
  fl(center)
  flex-wrap wrap
  padding 0 24px
.pg-jp-listen_a-box
  f(#fff, 32, 48)
  flex none
  box-sizing border-box
  margin 0 8px 8px
  width 48px
  border-radius 4px
  background-color cp
  text-align center
  &.is-current
    outline 2px solid cw
  &.is-correct
    background-color cs
  &.is-error
    background-color cd
