.pg-books_item
  display inline-flex
  margin-bottom 8px
  cursor pointer
  &:hover
    .pg-books_cover
      top 0
      left 0
      width 100%
      height 100%
    .pg-books_info
      padding-left 16px
.pg-books_title
  getFont(.65, 16, 24)
.pg-books_cover-wrap
  position relative
  max-width 40vw
  width 240px
.pg-books_cover-offset
  position relative
  padding-bottom 100%
  width 100%
  height 0
.pg-books_cover
  position absolute
  top 16px
  left 16px
  width calc(100% - 32px)
  height calc(100% - 32px)
  box-shadow 5px 5px 3px 1px #aaa
  transition all .3s ease
.pg-books_info
  padding 16px 0
  transition all .3s ease
.pg-books_title
  getFont(.85, 24, 32)
  weight(600)
  margin-bottom 16px
.pg-books_author, .pg-books_illustrator
  getFont(.65, 16, 24)
  margin-bottom 8px
  font-style italic
