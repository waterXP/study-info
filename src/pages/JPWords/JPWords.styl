.pg-jp-words
  display flex
  flex-direction column
  overflow hidden
  box-sizing border-box
  width 100vw
  height 100vh
  user-select none
.pg-jp-words_content
  display flex
  flex auto
  flex-direction column
  justify-content center
  overflow hidden
  box-sizing border-box
  padding 24px 32px
.pg-jp-words_body
  justify-content center
  overflow auto
.pg-jp-words_list
  flex none
  padding-top 16px
.pg-jp-words_line
  getFont(.85, 24, 32)
  weight()
  flex none
  padding-bottom 16px
  text-align center
  white-space normal
  word-break break-all
.pg-jp-words_footer
  display flex
  flex none
  flex-direction column
  overflow hidden
.pg-jp-words_buttons
  display flex
  flex none
  justify-content space-between
  align-items center
  box-sizing border-box
  width 100vw
.pg-jp-words_corner-center
  flex auto
  margin 0 2px
  padding 16px 0 0
  min-width 30vw
  max-width 50vw
  height 80px
  border-radius 20px 20px 0 0
  background-color cw
  color #fff
  text-align center
  font-size 24px
.pg-jp-words_corner-button
  flex none
  padding 16px 0 0
  min-width 30vw
  max-width 50vw
  height 80px
  border-radius 0 20px 0 0
  background-color cw
  color #fff
  text-align center
  font-size 24px
  &.is-right
    border-radius 20px 0 0 0
