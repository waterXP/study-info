.pg-cabinet-save
  flf(auto, center)
  flex-direction column
.pg-cabinet-save_title
  getFont(.85, 32, 48)
  flex none
  padding-top 24px
.pg-cabinet-save_box
  getFont(.85, 32, 48)
  flex none
  flex none
  margin-top 48px
  padding 24px 32px
  border 1px solid rgba(0, 0, 0, .65)
  border-radius 4px
.pg-cabinet-save_tip
  getFont(.85, 24, 32)
  flex none
  margin 32px 0 48px
.pg-cabinet-save_important
  color #ea4436
.pg-cabinet-save_buttons
  flf(none, center)
.pg-cabinet-save_button
  getFont(.85, 24, 32)
  flex none
  margin 0 24px
  padding 16px 48px
  border 1px solid rgba(0, 0, 0, .65)
  border-radius 16px
  &.is-disabled
    opacity .25
    cursor not-allowed
