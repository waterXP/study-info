.pg-jp-exec
  display flex
  flex-direction column
  overflow hidden
  box-sizing border-box
  width 100vw
  height 100vh
  user-select none
.pg-jp-exec_content
  display flex
  flex auto
  flex-direction column
  overflow hidden
  box-sizing border-box
  padding 24px 0 80px
.pg-jp-exec_header
  flex none
  padding 0 32px
.pg-jp-exec_lesson
  flex auto
  overflow auto
  padding 0 32px
.pg-jp-exec_topic
  getFont(.85, 16, 24)
  wb()
.pg-jp-exec_titles
  margin 8px 0
.pg-jp-exec_title
  getFont(.85, 16, 24)
  wb()
.pg-jp-exec_cn
  getFont(.45, 14, 24)
  padding-left 8px
.pg-jp-exec_footer
  display flex
  flex none
  flex-direction column
  overflow hidden
.pg-jp-exec_buttons
  display flex
  flex none
  justify-content space-between
  align-items center
  box-sizing border-box
  width 100vw
.pg-jp-exec_corner-button
  flex none
  padding 16px 0 0
  min-width 30vw
  max-width 50vw
  height 80px
  border-radius 0 20px 0 0
  background-color cw
  color #fff
  text-align center
  font-size 24px
  &.is-right
    border-radius 20px 0 0 0
.pg-jp-exec_examples
  padding-bottom 16px
  font-style italic
.pg-jp-exec_example
  getFont(.65, 14, 18)
  padding-left 8px
  min-height 8px
